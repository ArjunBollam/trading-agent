# Copy to .env and fill in. .env is git-ignored.

# Alpaca PAPER keys (they start with PK). paperbot refuses live keys (AK...).
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# AI provider: set llm.provider in config.yaml, then fill in that provider's key.
# Claude (llm.provider: anthropic)
ANTHROPIC_API_KEY=
# Grok from xAI (llm.provider: xai), from console.x.ai
XAI_API_KEY=
# Groq (llm.provider: groq), from console.groq.com
GROQ_API_KEY=

# Phone alerts via ntfy (install the ntfy app and subscribe to NTFY_TOPIC).
# Topic names on ntfy.sh are public, so pick long random strings, e.g. `openssl rand -hex 16`.
NTFY_TOPIC=
# Optional: a second topic you publish to from your phone to control the bot
# ("halt", "flatten", "status"). Leave empty to disable phone control.
NTFY_CONTROL_TOPIC=
# Optional: ntfy access token if your topics are access-controlled.
NTFY_TOKEN=

# Optional dead man's switch: a healthchecks.io (or similar) ping URL. If paperbot stops
# pinging (crash, sleep, no network), that service alerts you.
HEALTHCHECK_URL=

# Or Telegram instead of ntfy (set alerts.provider: telegram in config.yaml).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Robinhood, for `paperbot scan` (read-only chart signals on your positions; it never trades).
# The MCP server URL from claude.ai Settings > Connectors > Robinhood. Sign in once with
# `paperbot robinhood-login`, which also lists your account numbers.
ROBINHOOD_MCP_URL=
ROBINHOOD_ACCOUNT_NUMBER=
